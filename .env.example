# ---- LLM ผ่าน API (OpenAI-compatible) ----
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-xxxxxxxx
LLM_MODEL=qwen/qwen-2.5-72b-instruct
# JUDGE_MODEL=qwen/qwen-2.5-72b-instruct
TEMPERATURE=0.2

# ---- Harness ----
MAX_STEPS=8
MAX_POLICY_RETRIES=2
TOOL_RESULT_MAX_CHARS=6000

# ---- External store ----
BACKEND=opensearch          # opensearch | local
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
INDEX_NAME=lawguide-lpa
TOP_K=5
USE_VECTOR=auto            # auto = ใช้ vector ถ้าติดตั้ง sentence-transformers แล้ว
EMBED_MODEL=BAAI/bge-m3

# ---- แหล่งตัวบท ----
SOURCE_FILE=data/raw/lpa2541.txt

# ---- PII ----
PII_LLM_EXTRACT=0
# PII_LLM_BASE_URL=http://localhost:11434/v1   # แนะนำ LLM ในเครื่อง (Ollama) เพื่อไม่ส่งข้อความดิบออกนอกเครื่อง
# PII_LLM_MODEL=qwen2.5:7b
